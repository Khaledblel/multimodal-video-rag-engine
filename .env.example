API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=3000
LOG_LEVEL=INFO
ASR_ENABLED=true
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=
TEXT_EMBED_MODEL=qwen3-embedding:0.6b
TEXT_EMBED_DIM=1024
INDEX_ENABLED=true
FRAME_EMBED_ENABLED=true
FRAME_EMBED_MODEL=google/siglip2-so400m-patch14-384
FRAME_EMBED_DIM=1152
EMBED_DEVICE=auto
FUSION_TEXT_WEIGHT=1.0
FUSION_FRAME_WEIGHT=1.0
VLM_ENABLED=true
VLM_MODEL=qwen3-vl:8b-instruct
VLM_NUM_CTX=16384
VLM_FRAME_SIDE=768
VLM_KEEP_ALIVE=5m
VLM_THINK=false
PLANNER_ENABLED=true
PROXY_ENABLED=true
PROXY_SIZE=720
# With an NVIDIA GPU, uncomment the next line (deploy/vm/bootstrap.sh adds it by itself):
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
